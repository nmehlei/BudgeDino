# Copy to .env and fill in. Never commit real values.

# PostgreSQL connection string
DATABASE_URL=postgres://budgedino:CHANGE_ME@localhost:5432/budgedino

# Master key: 32 random bytes, base64. Generate with `budgedino init-key`.
# Set exactly one of the two. Losing the key means losing all data.
BUDGEDINO_MASTER_KEY=
# BUDGEDINO_MASTER_KEY_FILE=/run/secrets/budgedino_master_key

# PORT=8080
# HOST=0.0.0.0

# Behind a reverse proxy: number of proxy hops (e.g. 1) or a comma-separated list of proxy IPs/CIDRs.
# The literal "true" is rejected. Default: off.
# BUDGEDINO_TRUST_PROXY=1

# Concurrent bank syncs per process (default 2)
# BUDGEDINO_MAX_CONCURRENT_SYNCS=2

# Enabled connector types (comma list). Empty by default in production.
# "fake" only when NODE_ENV is not "production" or BUDGEDINO_ALLOW_FAKE=1.
# BUDGEDINO_CONNECTORS=
# "fints" (DKB, Comdirect) additionally requires a FinTS product id registered with the ZKA
# (https://www.hbci-zka.de/register/prod_register.htm).
# BUDGEDINO_FINTS_PRODUCT_ID=
# BUDGEDINO_FINTS_PRODUCT_VERSION=1.0

# LOG_LEVEL=info

# OpenTelemetry: telemetry is off unless the endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-ingress-collector:4318
# OTEL_EXPORTER_OTLP_HEADERS=
