# Local development environment, read by scripts/dev.sh (pnpm dev:server / dev:seed / maestro:device).
# Optional: copy to .env.dev (gitignored) to override. Without .env.dev these defaults are used.
# Nothing here is a real secret. The master key is NOT configured here: scripts/dev.sh generates one
# into .dev/master.key (gitignored) on first use.

NODE_ENV=development
DATABASE_URL=postgres://budgedino:budgedino@localhost:5433/budgedino
HOST=0.0.0.0
PORT=8080
BUDGEDINO_CONNECTORS=fake
LOG_LEVEL=info

# TEST/DEV ONLY. TOTP secret (base32) of the demo member created by `pnpm dev:seed`; the Maestro
# runner derives login codes from it. Ignored (and never used) when NODE_ENV=production.
BUDGEDINO_DEV_TOTP_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP
