    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "fastify": "^5.12.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
