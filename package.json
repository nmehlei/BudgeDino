{
  "name": "budgedino",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @budgedino/server run build",
    "openapi": "pnpm build && node scripts/generate-openapi.mjs",
    "lint": "eslint .",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck && tsc -p tests/tsconfig.json && tsc -p scripts/tsconfig.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "fints:live": "tsx scripts/fints-live.ts",
    "test:build": "pnpm build && vitest run --project build",
    "format": "prettier --write .",
    "mobile:test": "pnpm --filter @budgedino/mobile run test",
    "mobile:lint": "eslint src/mobile",
    "mobile:typecheck": "pnpm --filter @budgedino/mobile run typecheck",
    "mobile:android": "APP_VARIANT=development pnpm --filter @budgedino/mobile exec expo run:android --device",
    "mobile:prebuild": "pnpm --filter @budgedino/mobile exec expo prebuild --platform android --no-install"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.0",
    "@opentelemetry/sdk-trace": "^3.1.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.20.5",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "fastify": "^5.12.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
